{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "witbit-labs",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "ENVIRONMENT": "production"
  }
}
